# Copie para .env e preencha os valores. O arquivo .env não é versionado.

# Porta da API
PORT=3001
NODE_ENV=development

# Origem permitida pelo CORS (endereço do frontend)
CORS_ORIGIN=http://localhost:5173

# Conexão com o PostgreSQL (igual ao docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5432/arrowbot

# Segredo para assinar os tokens JWT de sessão. Gere um valor longo e aleatório, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor
JWT_EXPIRES_IN=1d

# Client ID OAuth do Google — o mesmo usado no frontend.
# O backend usa este valor para validar o ID token recebido do Google.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
