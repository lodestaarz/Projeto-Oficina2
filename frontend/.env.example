# Copie para .env.local e preencha os valores.
# Variáveis expostas ao navegador precisam começar com VITE_ (não coloque segredos aqui).

# URL base da API. Em desenvolvimento, /api é encaminhado ao backend pelo Vite.
VITE_API_URL=/api

# Client ID OAuth do Google (Google Cloud Console > APIs e serviços > Credenciais)
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
